# Example environment — copy to .env and fill in real values. Never commit .env.
# dotenv-doctor checks your .env against this file.
PORT=3000 # @type port
DATABASE_URL=postgres://user:password@localhost:5432/app # @type url
NODE_ENV=development # @enum development,test,production
DEBUG=false # @type boolean
API_TIMEOUT_MS=5000 # @type number
SUPPORT_EMAIL=support@example.com # @type email
JWT_SECRET= # secret — leave empty in the example
SMTP_HOST=smtp.example.com
