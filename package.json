{
  "author": "Gaurav Kumar Yadav",
  "bin": {
    "dotenv-doctor": "./dist/cli.js"
  },
  "bugs": {
    "url": "https://github.com/xgauravyaduvanshii/dotenv-doctor/issues"
  },
  "description": "Fail-fast CLI that checks a .env file against .env.example, validates types, and warns about secret-shaped values \u2014 without ever printing secret values.",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/xgauravyaduvanshii/dotenv-doctor#readme",
  "keywords": [
    "dotenv",
    "env",
    "validation",
    "cli",
    "ci",
    "environment-variables",
    "fail-fast"
  ],
  "license": "MIT",
  "main": "./dist/cli.js",
  "name": "dotenv-doctor",
  "repository": {
    "type": "git",
    "url": "https://github.com/xgauravyaduvanshii/dotenv-doctor.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "node dist/cli.js check",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "version": "0.2.0"
}